# Google OAuth (Auth.js)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_SECRET=your_auth_secret_generated_via_openssl

# Supabase
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ─── Supabase Storage (product image uploads) ─────────────────────────────
#
# Read on the SERVER only, by app/api/upload. No NEXT_PUBLIC_ prefix is needed
# and none should be added: that prefix inlines a value into the browser bundle,
# which is pointless here and, for the wrong variable, dangerous.
#
# Supabase renamed these keys. The "anon key" (a JWT starting eyJ) is now the
# "publishable key" (sb_publishable_...). Both formats work — the client only
# checks the key is non-empty and passes it through as the apikey header — and
# lib/supabase accepts either name, so a project set up before or after the
# rename needs no changes.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_BUCKET=fit
#
# NEVER set the SECRET key (sb_secret_..., formerly service_role) for this app.
# It bypasses row-level security entirely, nothing here reads it, and uploads do
# not need it. If one has ever been pasted anywhere it can be read, rotate it.
#
# Legacy names, still accepted so existing deployments keep working:
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_SUPABASE_BUCKET

# App
# Must be the PUBLIC origin. Wayle posts webhooks here, so localhost will not
# receive callbacks — use a tunnel (ngrok/cloudflared) for local testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Wayle payment gateway ────────────────────────────────────────────────
# Sent as the X-WAYL-AUTHENTICATION header.
WAYLE_API_KEY=your_wayle_api_key
# Sent per payment link; Wayle signs each webhook with it (HMAC-SHA256).
# The server refuses to process payments if this is missing rather than
# accepting unverified webhooks.
WAYLE_WEBHOOK_SECRET=your_wayle_webhook_secret
WAYLE_BASE_URL=https://api.wayl.one

# USD -> IQD conversion rate. Money-critical: Wayle charges the IQD figure the
# server sends. Defaults to 1500 (matching CurrencyFormatter) when unset, and
# the rate used is stored on every payment intent for reconciliation.
USD_TO_IQD_RATE=1500
# Same rate, exposed to the browser so the storefront and dashboard display the
# figure the customer will actually be charged. Keep the two values identical.
NEXT_PUBLIC_USD_TO_IQD_RATE=1500

# Shared secret for the scheduled stock-release sweep.
# POST /api/payments/expire accepts `Authorization: Bearer $CRON_SECRET`, or an
# admin session. WITHOUT a scheduler calling it, stock reserved by abandoned
# online checkouts is only released when someone else starts a checkout — on a
# quiet day it is held indefinitely.
CRON_SECRET=generate_a_long_random_string
