generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Models ───────────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  role              Role               @default(CUSTOMER)
  permissions       Permission?
  orders            Order[]
  couponRedemptions CouponRedemption[]
  accounts          Account[]
  sessions          Session[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ───────────────────────────────────────────────

model Product {
  id         String      @id @default(cuid())
  titleEn    String
  titleAr    String
  slug       String      @unique
  descEn     String?
  descAr     String?
  /// Per-product sizing notes shown under the size guide on the product page.
  /// Optional: the page always renders the shop-wide EU/UK/US conversion table,
  /// and this only adds anything specific to the shoe ("runs small, take a size
  /// up"). Null means the table is shown on its own.
  sizeGuideEn String?
  sizeGuideAr String?
  /// Delivery and returns copy for this product. Optional, and the section is
  /// HIDDEN when it is empty rather than falling back to invented boilerplate —
  /// a shipping promise the shop has not actually made is worse than no section.
  deliveryEn String?
  deliveryAr String?
  price      Float
  salePrice  Float?
  images     String[]
  category   Category    @relation(fields: [categoryId], references: [id])
  categoryId String
  /// Which sizes and colours this shoe is SOLD in. The quantities live on
  /// ProductVariant — these two only decide which rows the grid offers.
  sizes      String[]
  colors     String[]
  /// Inventory, one row per (size, colour) pair actually held.
  ///
  /// This replaced a single `stock Int` on the product. That number covered
  /// every size and every colour at once, so a shoe with nineteen pairs across
  /// five sizes and three colours could be ordered nineteen times in one size —
  /// the check and the decrement were both blind to which pair was being sold,
  /// and the shop oversold whatever size the customer happened to want.
  ///
  /// There is deliberately NO total column beside it. A denormalised total is a
  /// second source of truth for the one number that must never be wrong, and it
  /// drifts the first time an update misses it; the total is summed from here.
  variants   ProductVariant[]
  isActive   Boolean     @default(true)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

/// Stock for one (size, colour) pair of one product.
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      String
  color     String
  stock     Int     @default(0)

  /// One row per pair, enforced by the database rather than by hoping the
  /// application never writes a duplicate — two rows for the same pair would
  /// make "how many size 40 in black" a question with two answers.
  @@unique([productId, size, color])
  @@index([productId])
}

/// Two-level catalogue tree: a SECTION (parentId null, e.g. "الأحذية") holding
/// CATEGORIES (e.g. "حذاء فلات", "حذاء بكعب"), which is what products attach to.
///
/// One self-referencing model rather than separate Section and Category tables.
/// The five categories that existed before this were already shoe types, so they
/// became children of a new section without a single product being re-assigned —
/// two tables would have meant migrating every product's foreign key.
///
/// Depth is capped at two in the API, not by the schema: a row with a parent
/// cannot be given children, and a row with children cannot be given a parent.
/// Postgres has no way to express that, so lib/categories/tree.ts owns the rule
/// and every write goes through it.
model Category {
  id       String    @id @default(cuid())
  nameEn   String
  nameAr   String
  slug     String    @unique
  image    String?

  parentId String?
  /// Restrict, not Cascade: deleting a section must never silently take its
  /// categories — and their products — with it.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Order {
  id     String      @id @default(cuid())
  user   User        @relation(fields: [userId], references: [id])
  userId String
  items  OrderItem[]

  // Money breakdown.
  //
  // `total` remains the amount actually payable, so every existing reader of it
  // (the dashboard, the customer's order list, the Wayle amount) stays correct
  // without change. subtotal + discount explain how it was reached:
  //   total == subtotal - discount
  //
  // Defaulted to 0 for rows written before coupons existed; those are
  // backfilled to subtotal = total, discount = 0.
  subtotal Float @default(0)
  discount Float @default(0)

  // The coupon is recorded by id AND by code. The id is the live link; the code
  // is a snapshot, so an order still shows what was used after the coupon is
  // renamed or deleted.
  couponId         String?
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  couponRedemption CouponRedemption?

  total    Float
  status   OrderStatus @default(PENDING)
  notes    String?
  phone    String?
  location String?

  // Payment. `status` above is the DELIVERY lifecycle and must never be used to
  // track money; these two carry the payment state instead.
  paymentMethod PaymentMethod  @default(COD)
  paymentStatus PaymentStatus  @default(UNPAID)
  paidAt        DateTime?
  paymentIntent PaymentIntent?

  // Delivery tracking (admin-controlled)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // Customer feedback (after delivery)
  rating   Int?
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer order history is always "my orders, newest first".
  @@index([userId, createdAt])
  // The dashboard list filters by status and sorts by createdAt in one query;
  // an index on status alone cannot serve the sort, so Postgres sorted the
  // whole matching set on every page.
  @@index([status, createdAt])
  // Same query for a customer: their own orders, optionally filtered by status.
  // Subsumes [userId, createdAt] above, which is kept for clarity.
  @@index([userId, status, createdAt])
  @@index([createdAt])
}

/// One attempt to collect money for an order through a payment provider.
///
/// This table — not `Order` — carries the idempotency claim. Wayle delivers
/// webhooks at-least-once, so fulfilment claims `status` atomically
/// (PENDING -> PROCESSING) with a conditional updateMany inside a transaction;
/// a second delivery matches 0 rows and stops.
model PaymentIntent {
  id String @id @default(cuid())

  /// Opaque key we generate and send to Wayle as `referenceId`. Carries no
  /// encoded data on purpose — everything lives in this row instead.
  referenceId String @unique

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique

  /// Denormalised so the polling endpoint can do an ownership check without
  /// joining through Order.
  userId String

  /// The exact integer IQD figure sent to Wayle. Fulfilment validates the
  /// webhook against THIS, never against a recomputed price.
  amountIqd    Int
  /// USD subtotal and the rate used, kept for reconciliation.
  amountUsd    Float
  rateUsdToIqd Float
  currency     String @default("IQD")

  status   PaymentStatus @default(PENDING)
  provider String        @default("WAYLE")

  /// Wayle's own id for the link, and the hosted URL we redirect the payer to.
  providerPaymentId String?
  paymentUrl        String?
  paymentMethodUsed String?

  failureReason String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  size      String?
  color     String?

  @@index([orderId])
  @@index([productId])
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum PaymentMethod {
  COD // Cash on delivery — الدفع عند الاستلام
  WAYLE // Online payment via the Wayle hosted link
}

enum PaymentStatus {
  UNPAID // COD orders: nothing to collect online
  PENDING // Wayle link issued, waiting for the webhook
  PROCESSING // Claimed by a webhook delivery (idempotency lock)
  PAID
  FAILED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

model Permission {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Products
  canViewProducts   Boolean @default(false)
  canCreateProducts Boolean @default(false)
  canEditProducts   Boolean @default(false)
  canDeleteProducts Boolean @default(false)

  // Orders
  canViewOrders   Boolean @default(false)
  canEditOrders   Boolean @default(false)
  canDeleteOrders Boolean @default(false)

  // Customers
  canViewCustomers Boolean @default(false)

  // Categories
  canViewCategories   Boolean @default(false)
  canCreateCategories Boolean @default(false)
  canEditCategories   Boolean @default(false)
  canDeleteCategories Boolean @default(false)

  // Settings
  canViewSettings Boolean @default(false)
  canEditSettings Boolean @default(false)

  // Analytics / Overview
  canViewDashboard Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Where on the home page a banner is shown.
///
/// Every banner used to feed the hero carousel AND the collection strip at the
/// bottom, while the four side-by-side catalogue panels were hardcoded image
/// paths in the component with no way to edit them. This is what lets one admin
/// screen manage all three areas.
enum BannerPlacement {
  /// Full-width carousel at the top.
  HERO
  /// The paired image panels — two per row, linking wherever the admin points
  /// them, which is how a panel can lead to a specific product.
  CATALOG
  /// The grid strip near the foot of the page.
  COLLECTION
  /// The single full-bleed panel with the centred heading.
  SHOWCASE
}

model Banner {
  id        String   @id @default(cuid())
  titleEn   String?
  titleAr   String?
  btnTextEn String?
  btnTextAr String?
  /// Small line above the heading. Only the showcase panel renders it today;
  /// null everywhere else, which is why it is optional rather than defaulted.
  subtitleEn String?
  subtitleAr String?
  image     String
  link      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  /// Defaults to HERO so every existing banner keeps behaving exactly as it did
  /// before this column existed.
  placement BannerPlacement @default(HERO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, order])
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAr   String
  contentEn String   @db.Text
  contentAr String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  /**
   * `value` is a percentage of the subtotal, 1–100.
   */
  PERCENT
  /**
   * `value` is a fixed amount off, in USD (the currency prices are stored in).
   */
  FIXED
}

model Coupon {
  id   String       @id @default(cuid())
  /**
   * Stored upper-cased and trimmed. Shoppers type codes inconsistently, so
   * every lookup normalises the input the same way rather than relying on the
   * database being case-insensitive.
   */
  code String       @unique
  type DiscountType @default(PERCENT)

  /**
   * Percent (1–100) when type is PERCENT, else a fixed USD amount.
   */
  value Float

  /**
   * Order subtotal (USD) the basket must reach before the code applies.
   */
  minSubtotal Float?
  /**
   * Ceiling on a PERCENT discount, so "50% off" cannot cost more than this.
   */
  maxDiscount Float?

  startsAt  DateTime?
  expiresAt DateTime?

  /**
   * Total redemptions allowed across all shoppers. Null means unlimited.
   */
  maxRedemptions Int?
  /**
   * Redemptions allowed per shopper. Null means unlimited.
   */
  maxPerUser     Int? @default(1)

  /**
   * Live count of non-voided redemptions, maintained by the conditional update
   * in lib/coupons/redeem.ts. It is a claim counter, not a cached statistic —
   * incrementing it under a `redeemedCount < max` guard is what makes hitting
   * the limit race-free.
   */
  redeemedCount Int @default(0)

  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive])
}

model CouponRedemption {
  id       String @id @default(cuid())
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  /**
   * One coupon per order — enforced by the database, not by application code.
   */
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String @unique

  /**
   * Monotonic per (coupon, user) counter that makes the per-user limit
   * race-safe. Two concurrent checkouts both compute the same next slot, so the
   * unique index below rejects one of them — which a plain `count()` check
   * inside the transaction could not do under READ COMMITTED.
   * Never reused: voiding sets `voidedAt` rather than deleting, so a released
   * slot cannot collide with a later redemption.
   */
  slot Int

  /**
   * Discount actually granted, in USD. Frozen at redemption time.
   */
  amount Float

  /**
   * Set when the order was cancelled and the redemption handed back. The row
   * survives for audit; `redeemedCount` is decremented at the same time.
   */
  voidedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([couponId, userId, slot])
  @@index([couponId, userId])
}

/// Newsletter sign-ups.
///
/// These used to be POSTed straight from the browser to
/// `https://express-brevomail.vercel.app/api/contacts` — a third-party endpoint
/// that shipped with the template and belongs to someone else. Every shopper who
/// entered an email in the footer (present on every page) or the pop-up sent
/// their address to an unrelated service, with no consent, no record kept here,
/// and no way to reach the list. They are stored first-party now.
model Subscriber {
  id    String @id @default(cuid())
  /// Stored lower-cased and trimmed; @unique makes re-subscribing idempotent.
  email String @unique

  /// Which form it came from, so the shop can tell the footer from the pop-up.
  source         String    @default("footer")
  /// Set when the address is removed, rather than deleting the row, so an
  /// unsubscribe cannot be undone by simply re-submitting the form.
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Shop-wide reassurance copy: the payment / cash-on-delivery / delivery trio
/// shown under the buy button and again above the footer.
///
/// One row per slot, and `slot` is unique, so the set cannot grow a fourth or
/// carry two rows for the same thing. The icon is NOT stored — it is chosen in
/// code from the slot, so an admin cannot pair a truck with the payment line.
///
/// This exists because the copy was written into the translation files, which
/// made every wording change a developer edit and, worse, meant the shop could
/// state one delivery term on the product page and another on the home page.
/// Both surfaces read these rows now.
model TrustBadge {
  id       String  @id @default(cuid())
  /// PAYMENT | COD | DELIVERY — validated against lib/settings/trustBadges.
  slot     String  @unique
  titleAr  String
  titleEn  String
  textAr   String
  textEn   String
  /// Hidden rather than deleted, so turning a claim off does not lose its copy.
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}
