generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Models ───────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role        @default(CUSTOMER)
  permissions   Permission?
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ───────────────────────────────────────────────

model Product {
  id         String      @id @default(cuid())
  titleEn    String
  titleAr    String
  slug       String      @unique
  descEn     String?
  descAr     String?
  price      Float
  salePrice  Float?
  images     String[]
  category   Category    @relation(fields: [categoryId], references: [id])
  categoryId String
  sizes      String[]
  colors     String[]
  stock      Int         @default(0)
  isActive   Boolean     @default(true)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model Category {
  id       String    @id @default(cuid())
  nameEn   String
  nameAr   String
  slug     String    @unique
  image    String?
  products Product[]
}

model Order {
  id       String      @id @default(cuid())
  user     User        @relation(fields: [userId], references: [id])
  userId   String
  items    OrderItem[]
  total    Float
  status   OrderStatus @default(PENDING)
  notes    String?
  phone    String?
  location String?

  // Payment. `status` above is the DELIVERY lifecycle and must never be used to
  // track money; these two carry the payment state instead.
  paymentMethod PaymentMethod  @default(COD)
  paymentStatus PaymentStatus  @default(UNPAID)
  paidAt        DateTime?
  paymentIntent PaymentIntent?

  // Delivery tracking (admin-controlled)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // Customer feedback (after delivery)
  rating   Int?
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer order history is always "my orders, newest first".
  @@index([userId, createdAt])
  // The dashboard list filters by status and sorts by createdAt in one query;
  // an index on status alone cannot serve the sort, so Postgres sorted the
  // whole matching set on every page.
  @@index([status, createdAt])
  // Same query for a customer: their own orders, optionally filtered by status.
  // Subsumes [userId, createdAt] above, which is kept for clarity.
  @@index([userId, status, createdAt])
  @@index([createdAt])
}

/// One attempt to collect money for an order through a payment provider.
///
/// This table — not `Order` — carries the idempotency claim. Wayle delivers
/// webhooks at-least-once, so fulfilment claims `status` atomically
/// (PENDING -> PROCESSING) with a conditional updateMany inside a transaction;
/// a second delivery matches 0 rows and stops.
model PaymentIntent {
  id String @id @default(cuid())

  /// Opaque key we generate and send to Wayle as `referenceId`. Carries no
  /// encoded data on purpose — everything lives in this row instead.
  referenceId String @unique

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique

  /// Denormalised so the polling endpoint can do an ownership check without
  /// joining through Order.
  userId String

  /// The exact integer IQD figure sent to Wayle. Fulfilment validates the
  /// webhook against THIS, never against a recomputed price.
  amountIqd    Int
  /// USD subtotal and the rate used, kept for reconciliation.
  amountUsd    Float
  rateUsdToIqd Float
  currency     String @default("IQD")

  status   PaymentStatus @default(PENDING)
  provider String        @default("WAYLE")

  /// Wayle's own id for the link, and the hosted URL we redirect the payer to.
  providerPaymentId String?
  paymentUrl        String?
  paymentMethodUsed String?

  failureReason String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  size      String?
  color     String?

  @@index([orderId])
  @@index([productId])
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum PaymentMethod {
  COD // Cash on delivery — الدفع عند الاستلام
  WAYLE // Online payment via the Wayle hosted link
}

enum PaymentStatus {
  UNPAID // COD orders: nothing to collect online
  PENDING // Wayle link issued, waiting for the webhook
  PROCESSING // Claimed by a webhook delivery (idempotency lock)
  PAID
  FAILED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

model Permission {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Products
  canViewProducts   Boolean @default(false)
  canCreateProducts Boolean @default(false)
  canEditProducts   Boolean @default(false)
  canDeleteProducts Boolean @default(false)

  // Orders
  canViewOrders   Boolean @default(false)
  canEditOrders   Boolean @default(false)
  canDeleteOrders Boolean @default(false)

  // Customers
  canViewCustomers Boolean @default(false)

  // Categories
  canViewCategories   Boolean @default(false)
  canCreateCategories Boolean @default(false)
  canEditCategories   Boolean @default(false)
  canDeleteCategories Boolean @default(false)

  // Settings
  canViewSettings Boolean @default(false)
  canEditSettings Boolean @default(false)

  // Analytics / Overview
  canViewDashboard Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  titleEn   String?
  titleAr   String?
  btnTextEn String?
  btnTextAr String?
  image     String
  link      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAr   String
  contentEn String   @db.Text
  contentAr String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
